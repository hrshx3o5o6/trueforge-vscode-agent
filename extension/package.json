{
  "name": "trueforge-vscode-agent",
  "displayName": "TrueForge Coding Agent",
  "description": "A coding agent for VS Code whose agent loop runs on TrueForge (Techfest 2026-27 Forge-a-thon)",
  "version": "0.1.0",
  "publisher": "dihhbug",
  "repository": {
    "type": "git",
    "url": "https://github.com/hrshx3o5o6/trueforge-vscode-agent"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "trueforgeAgent.openPanel",
        "title": "TrueForge Agent: Open Panel"
      },
      {
        "command": "trueforgeAgent.inlineEdit",
        "title": "TrueForge Agent: Inline Edit Selection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "trueforgeAgent.inlineEdit",
          "group": "navigation",
          "when": "editorHasSelection"
        }
      ]
    },
    "keybindings": [
      {
        "command": "trueforgeAgent.inlineEdit",
        "title": "TrueForge Agent: Inline Edit Selection",
        "key": "cmd+k",
        "mac": "cmd+k",
        "win": "ctrl+k",
        "linux": "ctrl+k",
        "when": "editorHasSelection"
      },
      {
        "command": "trueforgeAgent.openPanel",
        "title": "TrueForge Agent: Open Panel",
        "key": "cmd+l",
        "mac": "cmd+l",
        "win": "ctrl+l",
        "linux": "ctrl+l"
      }
    ],
    "configuration": {
      "title": "TrueForge Agent",
      "properties": {
        "trueforgeAgent.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL of your local TrueForge server (npx @truefoundry/trueforge@latest)."
        },
        "trueforgeAgent.token": {
          "type": "string",
          "default": "",
          "description": "Bearer token, only needed if TrueForge OIDC login is enabled. Leave blank for local standalone mode."
        },
        "trueforgeAgent.primaryModel": {
          "type": "string",
          "default": "",
          "description": "Model name exactly as configured in TrueForge Settings -> Models, e.g. 'anthropic/claude-sonnet-4-6'."
        },
        "trueforgeAgent.fallbackModel": {
          "type": "string",
          "default": "",
          "description": "Second model name for automatic fallback (Task C resilience). Leave blank to disable fallback."
        },
        "trueforgeAgent.mcpServerPort": {
          "type": "number",
          "default": 4790,
          "description": "Local port for this extension's own MCP tool server. Register http://127.0.0.1:<port>/mcp in TrueForge Settings -> Connectors (no auth)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "^0.185.0",
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/express": "^4.17.21",
    "@types/diff": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
