    { "type": "text", "id": "t_turnrunner", "x": 325, "y": 150, "width": 220, "height": 70, "text": "turnRunner.ts\nstream, cancel, retry,\nfallback + context", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "turnrunner", "originalText": "turnRunner.ts\nstream, cancel, retry,\nfallback + context", "autoResize": true },

