    { "type": "text", "id": "t_a_turn_trueforge", "x": 565, "y": 160, "text": "SDK: sessions.create\ncreateTurnStream", "fontSize": 12, "fontFamily": 1, "strokeColor": "#757575", "originalText": "SDK: sessions.create\ncreateTurnStream", "autoResize": true },

