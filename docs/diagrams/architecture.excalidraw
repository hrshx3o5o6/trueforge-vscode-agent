{
  "type": "excalidraw",
  "version": 2,
  "source": "hermes-agent",
  "elements": [
    { "type": "text", "id": "title", "x": 260, "y": 20, "text": "Architecture: TrueForge VS Code Agent", "fontSize": 24, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "Architecture: TrueForge VS Code Agent", "autoResize": true },

    { "type": "rectangle", "id": "vscode_outer", "x": 40, "y": 80, "width": 520, "height": 480, "roundness": {"type": 3}, "strokeColor": "#1e1e1e", "backgroundColor": "transparent" },
    { "type": "text", "id": "t_vscode_outer", "x": 60, "y": 90, "text": "VS Code Extension Host Process", "fontSize": 16, "fontFamily": 1, "strokeColor": "#757575", "originalText": "VS Code Extension Host Process", "autoResize": true },

    { "type": "rectangle", "id": "webview", "x": 70, "y": 130, "width": 220, "height": 110, "roundness": {"type": 3}, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{"id": "t_webview", "type": "text"}] },
    { "type": "text", "id": "t_webview", "x": 80, "y": 155, "width": 200, "height": 60, "text": "Agent Panel\n(webview: plain HTML/CSS/JS)\nchat, diffs, tool-call log", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "webview", "originalText": "Agent Panel\n(webview: plain HTML/CSS/JS)\nchat, diffs, tool-call log", "autoResize": true },

    { "type": "rectangle", "id": "turnrunner", "x": 320, "y": 130, "width": 220, "height": 110, "roundness": {"type": 3}, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{"id": "t_turnrunner", "type": "text"}] },
    { "type": "text", "id": "t_turnrunner", "x": 330, "y": 155, "width": 200, "height": 60, "text": "turnRunner.ts\nstream, cancel, retry/backoff,\nfallback, context assembler", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "turnrunner", "originalText": "turnRunner.ts\nstream, cancel, retry/backoff,\nfallback, context assembler", "autoResize": true },

    { "type": "arrow", "id": "a_webview_turn", "x": 290, "y": 185, "width": 30, "height": 0, "points": [[0,0],[30,0]], "endArrowhead": "arrow", "startBinding": {"elementId": "webview", "fixedPoint": [1, 0.5]}, "endBinding": {"elementId": "turnrunner", "fixedPoint": [0, 0.5]} },

    { "type": "rectangle", "id": "mcpserver", "x": 70, "y": 280, "width": 470, "height": 230, "roundness": {"type": 3}, "backgroundColor": "#c3fae8", "fillStyle": "solid" },
    { "type": "text", "id": "t_mcpserver_title", "x": 90, "y": 290, "text": "MCP Tool Server (runs INSIDE the extension host)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "MCP Tool Server (runs INSIDE the extension host)", "autoResize": true },
    { "type": "text", "id": "t_mcpserver_why", "x": 90, "y": 312, "text": "needs vscode.* APIs for symbol/definition lookups - can't run standalone", "fontSize": 14, "fontFamily": 1, "strokeColor": "#757575", "originalText": "needs vscode.* APIs for symbol/definition lookups - can't run standalone", "autoResize": true },

    { "type": "rectangle", "id": "tool1", "x": 90, "y": 345, "width": 135, "height": 50, "roundness": {"type": 3}, "backgroundColor": "#ffffff", "boundElements": [{"id": "t_tool1", "type": "text"}] },
    { "type": "text", "id": "t_tool1", "x": 95, "y": 360, "width": 125, "height": 20, "text": "repo_map", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "tool1", "originalText": "repo_map", "autoResize": true },

