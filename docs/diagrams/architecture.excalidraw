    { "type": "text", "id": "t_mcpserver_why", "x": 80, "y": 312, "text": "needs vscode.* APIs - can't run standalone", "fontSize": 13, "fontFamily": 1, "strokeColor": "#757575", "originalText": "needs vscode.* APIs - can't run standalone", "autoResize": true },

