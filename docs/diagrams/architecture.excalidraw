    { "type": "text", "id": "t_trueforge_body", "x": 670, "y": 180, "width": 290, "height": 120, "text": "sessions & turns\nmodel.message.delta events\ntool.approval_required\nagent def (coding-agent.json)\nconnector: this MCP server", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "sessions & turns\nmodel.message.delta events\ntool.approval_required\nagent def (coding-agent.json)\nconnector: this MCP server", "autoResize": true },

