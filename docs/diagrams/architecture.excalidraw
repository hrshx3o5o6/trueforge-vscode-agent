    { "type": "text", "id": "t_a_trueforge_mcp", "x": 565, "y": 335, "text": "HTTP, bearer token\n/mcp (streamable-HTTP)", "fontSize": 12, "fontFamily": 1, "strokeColor": "#757575", "originalText": "HTTP, bearer token\n/mcp (streamable-HTTP)", "autoResize": true },

    { "type": "rectangle", "id": "model", "x": 710, "y": 390, "width": 200, "height": 90, "roundness": {"type": 3}, "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [{"id": "t_model", "type": "text"}] },
    { "type": "text", "id": "t_model", "x": 715, "y": 410, "width": 190, "height": 55, "text": "Model provider\ne.g. openai/gpt-5-4-mini\n+ fallback model", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "model", "originalText": "Model provider\ne.g. openai/gpt-5-4-mini\n+ fallback model", "autoResize": true },

    { "type": "arrow", "id": "a_trueforge_model", "x": 810, "y": 320, "width": 0, "height": 70, "points": [[0,0],[0,70]], "endArrowhead": "arrow", "startBinding": {"elementId": "trueforge", "fixedPoint": [0.5, 1]}, "endBinding": {"elementId": "model", "fixedPoint": [0.5, 0]} },

    { "type": "text", "id": "t_vscode_api_label", "x": 80, "y": 490, "text": "backed by: ripgrep, fs/child_process, vscode symbol/definition providers", "fontSize": 12, "fontFamily": 1, "strokeColor": "#757575", "originalText": "backed by: ripgrep, fs/child_process, vscode symbol/definition providers", "autoResize": true }
