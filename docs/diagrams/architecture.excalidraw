    { "type": "rectangle", "id": "webview", "x": 60, "y": 130, "width": 230, "height": 110, "roundness": {"type": 3}, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{"id": "t_webview", "type": "text"}] },
    { "type": "text", "id": "t_webview", "x": 65, "y": 150, "width": 220, "height": 70, "text": "Agent Panel\nwebview UI\nchat, diffs, tool log", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "webview", "originalText": "Agent Panel\nwebview UI\nchat, diffs, tool log", "autoResize": true },

