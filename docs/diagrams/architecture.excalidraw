    { "type": "rectangle", "id": "tool3", "x": 400, "y": 345, "width": 120, "height": 50, "roundness": {"type": 3}, "backgroundColor": "#ffffff", "boundElements": [{"id": "t_tool3", "type": "text"}] },
    { "type": "text", "id": "t_tool3", "x": 405, "y": 360, "width": 110, "height": 20, "text": "read_file", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "tool3", "originalText": "read_file", "autoResize": true },

    { "type": "rectangle", "id": "tool4", "x": 90, "y": 410, "width": 135, "height": 50, "roundness": {"type": 3}, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{"id": "t_tool4", "type": "text"}] },
    { "type": "text", "id": "t_tool4", "x": 95, "y": 425, "width": 125, "height": 20, "text": "propose_edit", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "tool4", "originalText": "propose_edit", "autoResize": true },

    { "type": "rectangle", "id": "tool5", "x": 245, "y": 410, "width": 170, "height": 50, "roundness": {"type": 3}, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{"id": "t_tool5", "type": "text"}] },
    { "type": "text", "id": "t_tool5", "x": 250, "y": 425, "width": 160, "height": 20, "text": "run_terminal_command", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "tool5", "originalText": "run_terminal_command", "autoResize": true },

    { "type": "rectangle", "id": "tool6", "x": 435, "y": 410, "width": 85, "height": 50, "roundness": {"type": 3}, "backgroundColor": "#ffffff", "boundElements": [{"id": "t_tool6", "type": "text"}] },
    { "type": "text", "id": "t_tool6", "x": 438, "y": 425, "width": 79, "height": 20, "text": "go_to_def", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "tool6", "originalText": "go_to_def", "autoResize": true },

    { "type": "text", "id": "t_approval_note", "x": 90, "y": 470, "text": "orange = approval-gated: pauses until the user accepts/rejects in the panel", "fontSize": 14, "fontFamily": 1, "strokeColor": "#757575", "originalText": "orange = approval-gated: pauses until the user accepts/rejects in the panel", "autoResize": true },

    { "type": "arrow", "id": "a_turn_mcp", "x": 350, "y": 240, "width": 0, "height": 40, "points": [[0,0],[0,40]], "endArrowhead": "arrow", "strokeStyle": "dashed", "startBinding": {"elementId": "turnrunner", "fixedPoint": [0.5, 1]}, "endBinding": {"elementId": "mcpserver", "fixedPoint": [0.5, 0]} },
    { "type": "text", "id": "t_a_turn_mcp", "x": 360, "y": 255, "text": "same process,\ndirect call", "fontSize": 14, "fontFamily": 1, "strokeColor": "#757575", "originalText": "same process,\ndirect call", "autoResize": true },

    { "type": "rectangle", "id": "trueforge", "x": 650, "y": 130, "width": 260, "height": 180, "roundness": {"type": 3}, "backgroundColor": "#b2f2bb", "fillStyle": "solid" },
    { "type": "text", "id": "t_trueforge_title", "x": 680, "y": 145, "text": "TrueForge (localhost:8790)", "fontSize": 18, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "TrueForge (localhost:8790)", "autoResize": true },
    { "type": "text", "id": "t_trueforge_body", "x": 670, "y": 180, "width": 220, "height": 110, "text": "sessions & turns\nmodel.message.delta streaming\ntool.approval_required\nagent definition (coding-agent.json)\nconnector: this MCP server", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "sessions & turns\nmodel.message.delta streaming\ntool.approval_required\nagent definition (coding-agent.json)\nconnector: this MCP server", "autoResize": true },

    { "type": "arrow", "id": "a_turn_trueforge", "x": 560, "y": 185, "width": 90, "height": 0, "points": [[0,0],[90,0]], "endArrowhead": "arrow", "startBinding": {"elementId": "turnrunner", "fixedPoint": [1, 0.3]}, "endBinding": {"elementId": "trueforge", "fixedPoint": [0, 0.3]} },
    { "type": "text", "id": "t_a_turn_trueforge", "x": 565, "y": 160, "text": "SDK: sessions.create\ncreateTurnStream", "fontSize": 13, "fontFamily": 1, "strokeColor": "#757575", "originalText": "SDK: sessions.create\ncreateTurnStream", "autoResize": true },

    { "type": "arrow", "id": "a_trueforge_mcp", "x": 650, "y": 290, "width": 100, "height": 90, "points": [[0,0],[-110,0],[-110,90]], "endArrowhead": "arrow", "startBinding": {"elementId": "trueforge", "fixedPoint": [0, 0.8]}, "endBinding": {"elementId": "mcpserver", "fixedPoint": [1, 0.1]} },
    { "type": "text", "id": "t_a_trueforge_mcp", "x": 555, "y": 310, "text": "HTTP, bearer token\nMCP streamable-HTTP\n(POST/GET/DELETE /mcp)", "fontSize": 13, "fontFamily": 1, "strokeColor": "#757575", "originalText": "HTTP, bearer token\nMCP streamable-HTTP\n(POST/GET/DELETE /mcp)", "autoResize": true },

    { "type": "rectangle", "id": "model", "x": 690, "y": 380, "width": 180, "height": 90, "roundness": {"type": 3}, "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [{"id": "t_model", "type": "text"}] },
    { "type": "text", "id": "t_model", "x": 700, "y": 400, "width": 160, "height": 50, "text": "Model provider\n(e.g. openai/gpt-5-4-mini,\nfallback model)", "fontSize": 15, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "model", "originalText": "Model provider\n(e.g. openai/gpt-5-4-mini,\nfallback model)", "autoResize": true },

    { "type": "arrow", "id": "a_trueforge_model", "x": 780, "y": 310, "width": 0, "height": 70, "points": [[0,0],[0,70]], "endArrowhead": "arrow", "startBinding": {"elementId": "trueforge", "fixedPoint": [0.5, 1]}, "endBinding": {"elementId": "model", "fixedPoint": [0.5, 0]} },

    { "type": "rectangle", "id": "editor", "x": 70, "y": 540, "width": 470, "height": 0 },

    { "type": "text", "id": "t_vscode_api_label", "x": 90, "y": 485, "text": "ripgrep + fs/child_process + vscode.commands.executeCommand (symbol/definition providers)", "fontSize": 13, "fontFamily": 1, "strokeColor": "#757575", "originalText": "ripgrep + fs/child_process + vscode.commands.executeCommand (symbol/definition providers)", "autoResize": true },

    { "type": "text", "id": "t_approvalnote2", "x": 650, "y": 330, "text": "tool.approval_required pauses TrueForge's turn\nuntil the user accepts/rejects per-hunk in the panel\n(B2's top anchor)", "fontSize": 14, "fontFamily": 1, "strokeColor": "#757575", "originalText": "tool.approval_required pauses TrueForge's turn\nuntil the user accepts/rejects per-hunk in the panel\n(B2's top anchor)", "autoResize": true }
