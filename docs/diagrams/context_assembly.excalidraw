    { "type": "rectangle", "id": "budget", "x": 680, "y": 150, "width": 280, "height": 150, "roundness": {"type": 3}, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "boundElements": [{"id": "t_budget", "type": "text"}] },
    { "type": "text", "id": "t_budget", "x": 690, "y": 165, "width": 260, "height": 120, "text": "Token budget gate\ncontextTokenBudget (6000)\n\nrepo_map: 4000 tokens\nread_file: 200 lines/call\n\nlowest-ranked candidates\ndropped FIRST, never\ntruncated mid-file", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "budget", "originalText": "Token budget gate\ncontextTokenBudget (6000)\n\nrepo_map: 4000 tokens\nread_file: 200 lines/call\n\nlowest-ranked candidates\ndropped FIRST, never\ntruncated mid-file", "autoResize": true },

    { "type": "arrow", "id": "a3", "x": 600, "y": 275, "width": 80, "height": 0, "points": [[0,0],[80,0]], "endArrowhead": "arrow", "startBinding": {"elementId": "retrieval", "fixedPoint": [1, 0.4]}, "endBinding": {"elementId": "budget", "fixedPoint": [0, 0.4]} },
    { "type": "arrow", "id": "a3b", "x": 600, "y": 160, "width": 80, "height": 50, "points": [[0,0],[80,-30]], "endArrowhead": "arrow", "startBinding": {"elementId": "mentions", "fixedPoint": [1, 0.3]}, "endBinding": {"elementId": "budget", "fixedPoint": [0, 0.15]} },

    { "type": "rectangle", "id": "card", "x": 720, "y": 360, "width": 270, "height": 120, "roundness": {"type": 3}, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{"id": "t_card", "type": "text"}] },
    { "type": "text", "id": "t_card", "x": 730, "y": 375, "width": 250, "height": 90, "text": "\"Context selected\" card\nin the panel: every file\nchosen, WHY, token cost,\ncandidates dropped", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "card", "originalText": "\"Context selected\" card\nin the panel: every file\nchosen, WHY, token cost,\ncandidates dropped", "autoResize": true },

    { "type": "arrow", "id": "a4", "x": 820, "y": 300, "width": 0, "height": 60, "points": [[0,0],[0,60]], "endArrowhead": "arrow", "startBinding": {"elementId": "budget", "fixedPoint": [0.5, 1]}, "endBinding": {"elementId": "card", "fixedPoint": [0.5, 0]} },

    { "type": "text", "id": "note", "x": 60, "y": 430, "width": 500, "height": 90, "text": "Why this beats \"whole files until the window fills\" (the 0-point anchor):\n- cost scales with relevance, not file size\n- the model never silently loses earlier turns to truncation\n- the human can SEE and audit what the agent actually looked at\n  before trusting its edit - this is what the scoring card calls out\n  by name as the top B1 anchor (\"+ size budget + visibly at work\n  in Task B\")", "fontSize": 15, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "Why this beats \"whole files until the window fills\" (the 0-point anchor):\n- cost scales with relevance, not file size\n- the model never silently loses earlier turns to truncation\n- the human can SEE and audit what the agent actually looked at\n  before trusting its edit - this is what the scoring card calls out\n  by name as the top B1 anchor (\"+ size budget + visibly at work\n  in Task B\")", "autoResize": true }
  ],
  "appState": { "viewBackgroundColor": "#ffffff" }
}
