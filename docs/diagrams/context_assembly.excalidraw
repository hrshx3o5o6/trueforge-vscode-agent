    { "type": "rectangle", "id": "mentions", "x": 350, "y": 90, "width": 250, "height": 90, "roundness": {"type": 3}, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{"id": "t_mentions", "type": "text"}] },
    { "type": "text", "id": "t_mentions", "x": 355, "y": 105, "width": 240, "height": 65, "text": "Resolve @-mentions\n(explicit, always\nincluded first)", "fontSize": 15, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "mentions", "originalText": "Resolve @-mentions\n(explicit, always\nincluded first)", "autoResize": true },

    { "type": "rectangle", "id": "retrieval", "x": 350, "y": 220, "width": 250, "height": 120, "roundness": {"type": 3}, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{"id": "t_retrieval", "type": "text"}] },
    { "type": "text", "id": "t_retrieval", "x": 355, "y": 240, "width": 240, "height": 80, "text": "Automatic retrieval\nIDF/BM25-ranked,\nsource/test/doc\nslots kept separate", "fontSize": 15, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "retrieval", "originalText": "Automatic retrieval\nIDF/BM25-ranked,\nsource/test/doc\nslots kept separate", "autoResize": true },

