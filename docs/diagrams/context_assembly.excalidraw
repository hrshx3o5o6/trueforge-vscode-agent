{
  "type": "excalidraw",
  "version": 2,
  "source": "hermes-agent",
  "elements": [
    { "type": "text", "id": "title", "x": 140, "y": 20, "text": "Context assembly (B1): budgeted, not whole-file dumping", "fontSize": 22, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "Context assembly (B1): budgeted, not whole-file dumping", "autoResize": true },

    { "type": "rectangle", "id": "input", "x": 60, "y": 90, "width": 230, "height": 90, "roundness": {"type": 3}, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{"id": "t_input", "type": "text"}] },
    { "type": "text", "id": "t_input", "x": 70, "y": 110, "width": 210, "height": 50, "text": "User message\n(+ optional @file / @symbol\nmentions)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "input", "originalText": "User message\n(+ optional @file / @symbol\nmentions)", "autoResize": true },

    { "type": "arrow", "id": "a1", "x": 290, "y": 135, "width": 60, "height": 0, "points": [[0,0],[60,0]], "endArrowhead": "arrow", "startBinding": {"elementId": "input", "fixedPoint": [1, 0.5]}, "endBinding": {"elementId": "mentions", "fixedPoint": [0, 0.5]} },

    { "type": "rectangle", "id": "mentions", "x": 350, "y": 90, "width": 220, "height": 90, "roundness": {"type": 3}, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{"id": "t_mentions", "type": "text"}] },
    { "type": "text", "id": "t_mentions", "x": 360, "y": 110, "width": 200, "height": 50, "text": "Resolve @-mentions exactly\n(explicit, always included\nfirst, highest priority)", "fontSize": 15, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "mentions", "originalText": "Resolve @-mentions exactly\n(explicit, always included\nfirst, highest priority)", "autoResize": true },

    { "type": "rectangle", "id": "retrieval", "x": 350, "y": 220, "width": 220, "height": 110, "roundness": {"type": 3}, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{"id": "t_retrieval", "type": "text"}] },
    { "type": "text", "id": "t_retrieval", "x": 360, "y": 240, "width": 200, "height": 70, "text": "Automatic retrieval\nIDF/BM25-ranked across\nrepo_map's index, source/\ntest/doc slots kept separate", "fontSize": 15, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "retrieval", "originalText": "Automatic retrieval\nIDF/BM25-ranked across\nrepo_map's index, source/\ntest/doc slots kept separate", "autoResize": true },

    { "type": "arrow", "id": "a2", "x": 460, "y": 180, "width": 0, "height": 40, "points": [[0,0],[0,40]], "endArrowhead": "arrow", "startBinding": {"elementId": "mentions", "fixedPoint": [0.5, 1]}, "endBinding": {"elementId": "retrieval", "fixedPoint": [0.5, 0]} },

    { "type": "rectangle", "id": "budget", "x": 650, "y": 150, "width": 240, "height": 140, "roundness": {"type": 3}, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "boundElements": [{"id": "t_budget", "type": "text"}] },
    { "type": "text", "id": "t_budget", "x": 660, "y": 170, "width": 220, "height": 100, "text": "Token budget gate\ntrueforgeAgent.contextTokenBudget\n(default 6000)\n\nrepo_map capped at 4000 tokens\n(REPO_MAP_TOKEN_BUDGET)\nread_file capped at 200 lines/call\nlowest-ranked candidates dropped\nFIRST, not truncated mid-file", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "budget", "originalText": "Token budget gate\ntrueforgeAgent.contextTokenBudget\n(default 6000)\n\nrepo_map capped at 4000 tokens\n(REPO_MAP_TOKEN_BUDGET)\nread_file capped at 200 lines/call\nlowest-ranked candidates dropped\nFIRST, not truncated mid-file", "autoResize": true },

    { "type": "arrow", "id": "a3", "x": 570, "y": 265, "width": 80, "height": 0, "points": [[0,0],[80,0]], "endArrowhead": "arrow", "startBinding": {"elementId": "retrieval", "fixedPoint": [1, 0.4]}, "endBinding": {"elementId": "budget", "fixedPoint": [0, 0.4]} },
    { "type": "arrow", "id": "a3b", "x": 570, "y": 160, "width": 80, "height": 50, "points": [[0,0],[80,-50]], "endArrowhead": "arrow", "startBinding": {"elementId": "mentions", "fixedPoint": [1, 0.3]}, "endBinding": {"elementId": "budget", "fixedPoint": [0, 0.15]} },

    { "type": "rectangle", "id": "card", "x": 700, "y": 350, "width": 230, "height": 110, "roundness": {"type": 3}, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{"id": "t_card", "type": "text"}] },
    { "type": "text", "id": "t_card", "x": 710, "y": 370, "width": 210, "height": 70, "text": "\"Context selected\" card\nshown in the panel: every\nfile chosen, WHY, token cost,\nhow many lower-ranked\ncandidates were dropped", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "card", "originalText": "\"Context selected\" card\nshown in the panel: every\nfile chosen, WHY, token cost,\nhow many lower-ranked\ncandidates were dropped", "autoResize": true },

    { "type": "arrow", "id": "a4", "x": 770, "y": 290, "width": 0, "height": 60, "points": [[0,0],[0,60]], "endArrowhead": "arrow", "startBinding": {"elementId": "budget", "fixedPoint": [0.5, 1]}, "endBinding": {"elementId": "card", "fixedPoint": [0.5, 0]} },

    { "type": "text", "id": "note", "x": 60, "y": 430, "width": 500, "height": 90, "text": "Why this beats \"whole files until the window fills\" (the 0-point anchor):\n- cost scales with relevance, not file size\n- the model never silently loses earlier turns to truncation\n- the human can SEE and audit what the agent actually looked at\n  before trusting its edit - this is what the scoring card calls out\n  by name as the top B1 anchor (\"+ size budget + visibly at work\n  in Task B\")", "fontSize": 15, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "Why this beats \"whole files until the window fills\" (the 0-point anchor):\n- cost scales with relevance, not file size\n- the model never silently loses earlier turns to truncation\n- the human can SEE and audit what the agent actually looked at\n  before trusting its edit - this is what the scoring card calls out\n  by name as the top B1 anchor (\"+ size budget + visibly at work\n  in Task B\")", "autoResize": true }
  ],
  "appState": { "viewBackgroundColor": "#ffffff" }
}
