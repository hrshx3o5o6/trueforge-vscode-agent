    { "type": "text", "id": "t_input", "x": 70, "y": 110, "width": 210, "height": 50, "text": "User message\n(+ optional @file / @symbol\nmentions)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "input", "originalText": "User message\n(+ optional @file / @symbol\nmentions)", "autoResize": true },

