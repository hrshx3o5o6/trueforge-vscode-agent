# Example environment. Copy to .env if you script TrueForge startup. Never commit real values.
# TrueForge must be allowed to reach the extension's localhost MCP server:
OUTBOUND_URL_ALLOWED_HOSTS=["localhost","127.0.0.1"]
TRUEFORGE_BASE_URL=http://localhost:8790
# TRUEFORGE_TOKEN=            # only needed if TrueForge OIDC login is enabled
MCP_SERVER_PORT=4790
# Model API keys are NOT configured here: add providers in the TrueForge UI
# (http://localhost:8790 -> Settings -> Models). Model names for the extension
# go in VS Code settings: see config/vscode-settings.example.json.
